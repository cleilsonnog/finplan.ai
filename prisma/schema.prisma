// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CustomCategory {
  id                String             @id @default(uuid())
  userId            String
  name              String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  transactions      Transaction[]
  budgets           Budget[]
  recurringExpenses RecurringExpense[]
  categoryRules     CategoryRule[]

  @@unique([userId, name])
}

model Transaction {
  id                 String                   @id @default(uuid())
  name               String
  type               TransactionType
  amount             Decimal                  @db.Decimal(10, 2)
  category           TransactionCategory
  paymentMethod      TransactionPaymentMethod
  date               DateTime
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  userId             String
  installments       Int                      @default(1)
  installmentNumber  Int                      @default(1)
  creditCardId       String?
  creditCard         CreditCard?              @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
  customCategoryId   String?
  customCategory     CustomCategory?          @relation(fields: [customCategoryId], references: [id], onDelete: SetNull)
  recurringExpenseId String?
  recurringExpense   RecurringExpense?        @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  recurringIncomeId  String?
  recurringIncome    RecurringIncome?         @relation(fields: [recurringIncomeId], references: [id], onDelete: SetNull)
  /// Free-text note ("emprestado para a tia", "cartão da Amanda")
  notes              String?                  @db.VarChar(500)
  source             TransactionSource        @default(MANUAL)
  /// Id of the line in the imported file (OFX FITID, or a hash of date+amount+description) — prevents re-importing
  externalId         String?
  importBatchId      String?
  importBatch        ImportBatch?             @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@unique([userId, externalId])
  @@index([userId, date])
  @@index([creditCardId])
}

enum TransactionSource {
  MANUAL
  WHATSAPP
  IMPORT
}

enum ImportFileType {
  OFX
  CSV
  PDF
}

/// One confirmed statement import (bank account or credit card bill)
model ImportBatch {
  id               String         @id @default(uuid())
  userId           String
  fileType         ImportFileType
  fileName         String
  creditCardId     String?
  creditCard       CreditCard?    @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
  transactionCount Int
  createdAt        DateTime       @default(now())
  transactions     Transaction[]

  @@index([userId, createdAt])
}

/// Learned categorization: statement descriptions containing `pattern` get this category
model CategoryRule {
  id               String              @id @default(uuid())
  userId           String
  /// Normalized merchant text (lowercase, no accents/digits), e.g. "mercado gomes"
  pattern          String
  category         TransactionCategory
  customCategoryId String?
  customCategory   CustomCategory?     @relation(fields: [customCategoryId], references: [id], onDelete: Cascade)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([userId, pattern])
}

enum TransactionType {
  DEPOSIT
  EXPENSE
  INVESTMENT
}

enum TransactionCategory {
  HOUSING
  TRANSPORTATION
  FOOD
  ENTERTAINMENT
  HEALTH
  UTILITY
  SALARY
  EDUCATION
  OTHER
}

enum TransactionPaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  BANK_SLIP
  CASH
  PIX
  OTHER
}

enum CardBrand {
  VISA
  MASTERCARD
  ELO
  AMEX
  HIPERCARD
  OTHER
}

enum BillStatus {
  OPEN
  CLOSED
  PAID
  OVERDUE
}

model CreditCardBill {
  id           String     @id @default(uuid())
  creditCardId String
  creditCard   CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  month        Int
  year         Int
  closingDate  DateTime
  dueDate      DateTime
  totalAmount  Decimal    @default(0) @db.Decimal(10, 2)
  status       BillStatus @default(OPEN)
  paidAt       DateTime?
  /// closingDate/dueDate are final: taken from the imported bill or frozen once the bill closed.
  /// Changing the card's closing day afterwards only affects open and future bills.
  datesLocked  Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  userId       String

  @@unique([creditCardId, month, year])
  @@index([userId, month, year])
}

model Budget {
  id               String              @id @default(uuid())
  userId           String
  category         TransactionCategory
  amount           Decimal             @db.Decimal(10, 2)
  month            Int
  year             Int
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  customCategoryId String?
  customCategory   CustomCategory?     @relation(fields: [customCategoryId], references: [id], onDelete: SetNull)

  @@unique([userId, category, customCategoryId, month, year])
  @@index([userId, month, year])
}

model CreditCard {
  id             String           @id @default(uuid())
  userId         String
  name           String
  lastFourDigits String
  brand          CardBrand
  bank           String
  limit          Decimal          @db.Decimal(10, 2)
  closingDay     Int
  dueDay         Int
  color          String           @default("blue")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  transactions   Transaction[]
  bills          CreditCardBill[]
  importBatches  ImportBatch[]

  @@index([userId])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model AccountShare {
  id        String   @id @default(uuid())
  ownerId   String
  memberId  String   @unique
  createdAt DateTime @default(now())
}

model AccountShareInvite {
  id           String       @id @default(uuid())
  ownerId      String
  invitedEmail String
  status       InviteStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([invitedEmail, status])
}

model WhatsAppLink {
  id        String   @id @default(uuid())
  userId    String   @unique
  phone     String   @unique
  createdAt DateTime @default(now())
}

model RecurringExpense {
  id               String              @id @default(uuid())
  userId           String
  name             String
  amount           Decimal             @db.Decimal(10, 2)
  category         TransactionCategory
  customCategoryId String?
  customCategory   CustomCategory?     @relation(fields: [customCategoryId], references: [id], onDelete: SetNull)
  dueDay           Int
  active           Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  transactions     Transaction[]

  @@index([userId])
}

model RecurringIncome {
  id           String        @id @default(uuid())
  userId       String
  name         String
  amount       Decimal       @db.Decimal(10, 2)
  receiveDay   Int
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]

  @@index([userId])
}

model WhatsAppSession {
  id          String   @id @default(uuid())
  phone       String   @unique
  pendingData Json
  step        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserCategoryLabel {
  id       String              @id @default(uuid())
  userId   String
  category TransactionCategory
  label    String

  @@unique([userId, category])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model ShoppingListItem {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  @@index([userId])
}
